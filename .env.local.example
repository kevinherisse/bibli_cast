# Supabase project settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Supabase project settings → API → service_role (SECRET — server only, never expose to the client)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Used to build the magic-link redirect URL. Set to your deployed URL in production
# (e.g. https://books.example.com). Falls back to the request origin if unset.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: shown in the "email not on the list" message on /login.
NEXT_PUBLIC_CONTACT_EMAIL=you@example.com
